# Copy to .env and fill in. Never commit .env.

# Postgres connection. The API creates/updates its tables on startup.
DATABASE_URL=postgres://smp:CHANGE_ME@localhost:5432/smp_portal

# Signs session tokens. At least 32 random characters: openssl rand -hex 32
JWT_SECRET=

# First admin account, created only if no admin exists yet. Use a strong password.
ADMIN_EMAIL=admin@school.local
ADMIN_PASSWORD=

# School timezone (IANA name). Decides what "today" is for attendance and notices.
SCHOOL_TIMEZONE=Asia/Kolkata

# Keep "false" only for local http development. Leave unset (secure) in production behind HTTPS.
COOKIE_SECURE=false

# Where the API listens.
BIND_ADDR=127.0.0.1:3000

# Log level: error, warn, info, debug
RUST_LOG=info
